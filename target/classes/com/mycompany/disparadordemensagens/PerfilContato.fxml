<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="350.0" prefWidth="450.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.disparadordemensagens.controller.PerfilContatoController">

    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Título -->
            <!-- Título -->
            <Label style="-fx-text-fill: #446ee1;               -fx-font-weight: bold;               -fx-font-size: 28px;               -fx-font-family: 'Arial Black';" text="Perfil" />
              

            <!-- Campo Email -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="Telefone" prefWidth="220" promptText="Telefone" style="-fx-background-color: #2c2c2c; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #444444;" />
            </HBox>
            
            <!-- Campo Nome -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="Email" prefWidth="220" promptText="Email" style="-fx-background-color: #2c2c2c; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #444444;" />
            </HBox>

            <!-- Campo Telefone -->
            <HBox alignment="CENTER" spacing="10">
                <TextField fx:id="Nome" prefWidth="220" promptText="Nome" style="-fx-background-color: #2c2c2c; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #444444;" />
            </HBox>

        </VBox>
    </children>
</AnchorPane>

